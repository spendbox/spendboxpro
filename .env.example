# Copy this file to .env.local for running on your computer.
# On Vercel, add the same names under Settings → Environment Variables.

# Supabase → Project Settings → API (or "Connect" → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: keep private. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Mono: connects businesses' bank accounts (read-only) so transfers count by themselves.
# Mono dashboard → your app → Keys. test_… keys use Mono's sandbox, live_… keys use real banks.
NEXT_PUBLIC_MONO_PUBLIC_KEY=test_pk_xxx
MONO_SECRET_KEY=test_sk_xxx
# Any long random text. Put the same text in Mono's webhook settings (see README).
MONO_WEBHOOK_SECRET=change-me-to-another-long-random-string

# The public address of your app, used in share links and QR codes.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Any long random text. Protects the daily job (birthday treats + bank check).
CRON_SECRET=change-me-to-a-long-random-string

# Optional ---------------------------------------------------------------
# Paystack secret key: looks up bank account names (Paystack → Settings → API Keys).
# PAYSTACK_SECRET_KEY=sk_live_xxx
# Resend: notification emails. EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Spendbox <hello@yourdomain.com>
# Admin area (/admin): the main admin's login. Changing either signs everyone out of /admin.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=at-least-10-characters

# Starting free-trial length in days (default 90). Change it later in /admin → Settings.
# NEXT_PUBLIC_TRIAL_DAYS=90
# Country code pre-selected on phone fields (default 234, Nigeria).
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=234
# Time zone for receipt times and dates (default Africa/Lagos).
# NEXT_PUBLIC_TIME_ZONE=Africa/Lagos
# "Send a test payment" on the Payments page (test keys only). Also a switch in /admin → Settings.
# TEST_PAYMENTS=on

# Receipt uploads (switched off while payments come from Mono). Set to "on" to bring them back;
# they also need an Anthropic key for Claude to read receipts (https://console.anthropic.com).
# NEXT_PUBLIC_RECEIPT_UPLOADS=on
# ANTHROPIC_API_KEY=sk-ant-xxx
# RECEIPT_MODEL=claude-opus-5-5
