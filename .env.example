# Copy this file to .env.local for running on your computer.
# On Vercel, add the same names under Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: keep private. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The public address of your app.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Any long random text. Protects the daily job (coin top-ups, and a backup tick of the round clock).
CRON_SECRET=change-me-to-a-long-random-string

# Resend: sends the 6-digit sign-in codes. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Hide & Seek <hello@yourdomain.com>

# Ads (/advertise). All optional: without PAYSTACK_SECRET_KEY the page says payments aren't
# switched on yet.
# Paystack → Settings → API Keys & Webhooks → Secret Key (sk_test_… while testing, sk_live_… when live).
PAYSTACK_SECRET_KEY=sk_test_xxx
# Your own email: told about every new ad (so you can take one down if needed).
ADMIN_EMAIL=you@yourdomain.com
# Any long random text. Keeps advertisers signed in to /advertiser safely. If you leave it out,
# CRON_SECRET is used instead (changing it signs every advertiser out).
ADVERTISER_SECRET=change-me-to-another-long-random-string
